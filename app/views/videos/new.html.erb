<% content_for :title, "Upload Video" %>

<div class="container py-5">
  <div class="page-shell">
    <div>
      <div class="page-header__eyebrow">Upload</div>
      <h1 class="page-title">Upload a video</h1>
      <p class="page-subtitle">Record or select a clip, add quick context, and we will analyze it.</p>
    </div>

    <div class="page-card"
      data-controller="bridge--video-upload"
      data-bridge--video-upload-upload-url-value="<%= native_upload_videos_url %>"
      data-bridge--video-upload-csrf-token-value="<%= form_authenticity_token %>">
      <%= form_with model: @video, url: videos_path, method: :post, data: { controller: "required-fields" } do |f| %>
        <div class="mb-3">
          <%= f.label :title, "Title (optional)", class: "form-label" %>
          <%= f.text_field :title, class: "form-control", placeholder: "Serve practice - May 3" %>
        </div>

        <div class="mb-4">
          <%= f.label :notes, "Describe what you're wearing", class: "form-label" %>
          <%= f.text_area :notes, rows: 2, class: "form-control", data: { "bridge--video-upload-target": "notes", "required-fields-target": "notes" }, placeholder: "Example: pink shirt and black shorts", required: true %>
          <div class="form-text">We use this to distinguish you from other players.</div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-12 col-md-6">
            <%= f.label :analysis_start, "Start time (optional)", class: "form-label" %>
            <%= f.text_field :analysis_start, class: "form-control", placeholder: "00:00:30", data: { "bridge--video-upload-target": "analysisStart" } %>
            <div class="form-text">Format: HH:MM:SS (or MM:SS).</div>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :analysis_end, "Stop time (optional)", class: "form-label" %>
            <%= f.text_field :analysis_end, class: "form-control", placeholder: "00:01:15", data: { "bridge--video-upload-target": "analysisEnd" } %>
            <div class="form-text">If both start and stop are set, duration is calculated automatically.</div>
          </div>
        </div>

        <% if hotwire_native_app? %>
          <div class="mb-4">
            <button type="button" class="btn btn-primary" data-action="click->bridge--video-upload#capture">
              Record or choose video
            </button>
          </div>
        <% end %>

        <% unless hotwire_native_app? %>
          <div class="mb-4">
            <%= f.label :original_video, "Video file", class: "form-label" %>
            <%= f.file_field :original_video, class: "form-control", accept: "video/*", direct_upload: true, data: { "required-fields-target": "file" }, required: true %>
          </div>
        <% end %>

        <div class="d-flex flex-wrap gap-2 align-items-center" data-controller="upload-progress">
          <%= f.submit "Upload", class: "btn btn-primary", data: { "required-fields-target": "submit", "upload-progress-target": "submit" }, disabled: true %>
          <span class="text-muted d-none" data-upload-progress-target="label">Uploading...</span>
          <div class="spinner-border spinner-border-sm text-primary d-none" role="status" data-upload-progress-target="spinner">
            <span class="visually-hidden">Uploading...</span>
          </div>
          <%= link_to "Back", root_path, class: "btn btn-outline-secondary" %>
        </div>

        <div class="progress mt-3 d-none" data-upload-progress-target="barWrap" aria-hidden="true">
          <div class="progress-bar" role="progressbar" style="width: 0%" data-upload-progress-target="bar"></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
