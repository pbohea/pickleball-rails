<% content_for :title, "Video ##{@video.id}" %>

<div class="container py-5">
  <div class="page-shell">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <div class="page-header__eyebrow">Video</div>
        <h1 class="page-title mb-1"><%= @video.title.presence || "Video ##{@video.id}" %></h1>
        <p class="page-subtitle mb-0">Uploaded <%= @video.uploaded_at&.strftime("%b %d, %Y at %I:%M %p") || @video.created_at.strftime("%b %d, %Y") %></p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Upload another", new_video_path, class: "btn btn-primary" %>
        <%= link_to "Dashboard", dashboard_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>

    <% if @video.notes.present? %>
      <div class="page-card page-card--soft">
        <h5>Your notes</h5>
        <p class="mb-0"><%= simple_format(@video.notes) %></p>
      </div>
    <% end %>

    <div data-controller="poll" data-poll-url-value="<%= status_video_path(@video) %>" data-poll-interval-value="4000">
      <turbo-frame id="batch">
        <%= render "status", video: @video, analysis: @analysis %>
      </turbo-frame>
    </div>

    <% if @video.original_video.attached? %>
      <div class="page-card">
        <h5>Original video</h5>
        <video controls preload="metadata" class="w-100 rounded">
          <source src="<%= url_for(@video.original_video) %>">
        </video>
      </div>
    <% end %>

    <% if @analysis&.summary.present? %>
      <div class="page-card">
        <h4>Coach feedback</h4>
        <% if @analysis.started_at.present? && @analysis.completed_at.present? %>
          <% duration_seconds = (@analysis.completed_at - @analysis.started_at).to_i %>
          <% minutes = duration_seconds / 60 %>
          <% seconds = duration_seconds % 60 %>
          <p class="text-muted mb-2">Processed in <%= pluralize(minutes, "minute") %> and <%= pluralize(seconds, "second") %>.</p>
        <% end %>
        <p><%= simple_format(@analysis.summary) %></p>
      </div>
    <% end %>

    <% coaching = @analysis&.cv_results&.dig("results", "coaching_summary") %>
    <% if coaching.is_a?(Hash) %>
      <% overall = coaching["overall"].is_a?(Hash) ? coaching["overall"] : {} %>
      <div class="page-card page-card--soft">
        <h5>Analysis details</h5>
        <% if overall["mean_contact"].present? %>
          <p class="mb-2">
            <strong>ReadyScore (contact):</strong>
            <%= format("%.1f", overall["mean_contact"].to_f) %>/100
            <% if overall["n_scored"].present? %>
              across <%= overall["n_scored"] %> shots
            <% end %>
          </p>
        <% end %>
        <% recommendations = Array(coaching["recommendations"]).compact %>
        <% if recommendations.any? %>
          <p class="mb-1"><strong>Top focus areas</strong></p>
          <ul class="mb-0">
            <% recommendations.first(3).each do |rec| %>
              <li><%= rec %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <% if @analysis.present? %>
      <% payload = @analysis.cv_results.is_a?(Hash) ? @analysis.cv_results : {} %>
      <% input = payload["input"].is_a?(Hash) ? payload["input"] : {} %>
      <% results = payload["results"].is_a?(Hash) ? payload["results"] : {} %>
      <% shot_summary = results["shot_summary"].is_a?(Hash) ? results["shot_summary"] : {} %>
      <% form_analysis = results["form_analysis"].is_a?(Hash) ? results["form_analysis"] : {} %>
      <% coaching_summary = results["coaching_summary"].is_a?(Hash) ? results["coaching_summary"] : {} %>
      <% overall = coaching_summary["overall"].is_a?(Hash) ? coaching_summary["overall"] : {} %>
      <% cv_meta = payload.except("input", "results") %>
      <% best_worst = shot_summary["best_worst_clips"] %>
      <% best_worst = form_analysis["best_worst_clips"] if !best_worst.is_a?(Hash) %>
      <% best_clips = best_worst.is_a?(Hash) ? Array(best_worst["best"]).compact : [] %>
      <% worst_clips = best_worst.is_a?(Hash) ? Array(best_worst["worst"]).compact : [] %>

      <% fmt_val = ->(v) { v.present? ? v : "n/a" } %>
      <% fmt_num = lambda do |v, digits = 2|
           begin
             v.nil? ? "n/a" : format("%.#{digits}f", Float(v))
           rescue
           "n/a"
           end
         end %>
      <% gcs_client = begin
           Gcp::StorageClient.new(bucket_name: ENV.fetch("GCS_BUCKET"))
         rescue
           nil
         end %>
      <% clip_url_for = lambda do |clip|
           c = clip.is_a?(Hash) ? clip : {}
           gcs_uri = c["gcs_uri"].to_s
           if gcs_client.present? && gcs_uri.start_with?("gs://")
             begin
               gcs_client.signed_url(gcs_uri, expires_in: 48 * 3600)
             rescue
               begin
                 gcs_client.public_url(gcs_uri)
               rescue
                 nil
               end
             end
           else
             direct = c["url"] || c["public_url"] || c["video_url"]
             if direct.present?
               direct
             else
               p = c["path"].to_s
               p.start_with?("http://", "https://") ? p : nil
             end
           end
         end %>

      <% if best_clips.any? || worst_clips.any? %>
        <div class="page-card">
          <h5>Best / Worst Clips</h5>
          <p class="text-muted mb-3">Videos render when the payload contains a public URL. Local runner file paths are shown as metadata only.</p>
          <div class="row g-4">
            <div class="col-12 col-lg-6">
              <h6 class="mb-3">Best Shots</h6>
              <% if best_clips.any? %>
                <% best_clips.each_with_index do |clip, idx| %>
                  <% url = clip_url_for.call(clip) %>
                  <div class="border rounded p-3 mb-3">
                    <p class="mb-2"><strong>#<%= idx + 1 %></strong> • <%= fmt_val.call(clip["shot_type"]) %> • score <%= fmt_num.call(clip["score"], 1) %></p>
                    <% if url.present? %>
                      <video controls preload="metadata" class="w-100 rounded">
                        <source src="<%= url %>">
                      </video>
                    <% else %>
                      <p class="text-muted mb-1">No public video URL in payload.</p>
                    <% end %>
                    <p class="text-muted mb-0 small">
                      frame=<%= fmt_val.call(clip["frame"]) %>
                      <% if clip["rally_index"].present? %> • rally=<%= clip["rally_index"] %><% end %>
                    </p>
                    <% if clip["path"].present? %>
                      <p class="text-muted mb-0 small">path: <%= clip["path"] %></p>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <p class="text-muted mb-0">n/a</p>
              <% end %>
            </div>
            <div class="col-12 col-lg-6">
              <h6 class="mb-3">Worst Shots</h6>
              <% if worst_clips.any? %>
                <% worst_clips.each_with_index do |clip, idx| %>
                  <% url = clip_url_for.call(clip) %>
                  <div class="border rounded p-3 mb-3">
                    <p class="mb-2"><strong>#<%= idx + 1 %></strong> • <%= fmt_val.call(clip["shot_type"]) %> • score <%= fmt_num.call(clip["score"], 1) %></p>
                    <% if url.present? %>
                      <video controls preload="metadata" class="w-100 rounded">
                        <source src="<%= url %>">
                      </video>
                    <% else %>
                      <p class="text-muted mb-1">No public video URL in payload.</p>
                    <% end %>
                    <p class="text-muted mb-0 small">
                      frame=<%= fmt_val.call(clip["frame"]) %>
                      <% if clip["rally_index"].present? %> • rally=<%= clip["rally_index"] %><% end %>
                    </p>
                    <% if clip["path"].present? %>
                      <p class="text-muted mb-0 small">path: <%= clip["path"] %></p>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <p class="text-muted mb-0">n/a</p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="page-card">
        <h5>Troubleshooting: Model Payload Debug</h5>
        <p class="text-muted mb-3">Everything below is what Rails has at render time for this analysis.</p>

        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <tbody>
              <tr><th scope="row">Analysis ID</th><td><%= @analysis.id %></td></tr>
              <tr><th scope="row">Analysis Status</th><td><%= @analysis.status %></td></tr>
              <tr><th scope="row">Model Version</th><td><%= fmt_val.call(@analysis.model_version) %></td></tr>
              <tr><th scope="row">Started At</th><td><%= fmt_val.call(@analysis.started_at) %></td></tr>
              <tr><th scope="row">Completed At</th><td><%= fmt_val.call(@analysis.completed_at) %></td></tr>
              <tr><th scope="row">Runner</th><td><%= fmt_val.call(payload["runner"]) %></td></tr>
              <tr><th scope="row">Request ID</th><td><%= fmt_val.call(payload["request_id"]) %></td></tr>
              <tr><th scope="row">Execution Name</th><td><%= fmt_val.call(payload["execution_name"]) %></td></tr>
              <tr><th scope="row">Input URI</th><td><%= fmt_val.call(payload["input_uri"]) %></td></tr>
              <tr><th scope="row">Output URI</th><td><%= fmt_val.call(payload["output_uri"]) %></td></tr>
              <tr><th scope="row">Desc Used</th><td><%= fmt_val.call(payload["desc"]) %></td></tr>
              <tr><th scope="row">Poll Attempts</th><td><%= fmt_val.call(payload["poll_attempts"]) %></td></tr>

              <tr><th scope="row">Input.Start</th><td><%= fmt_val.call(input["start"]) %></td></tr>
              <tr><th scope="row">Input.Duration</th><td><%= fmt_val.call(input["duration"]) %></td></tr>
              <tr><th scope="row">Input.FPS</th><td><%= fmt_val.call(input["fps"]) %></td></tr>
              <tr><th scope="row">Input.Width</th><td><%= fmt_val.call(input["width"]) %></td></tr>
              <tr><th scope="row">Input.Select T Sec</th><td><%= fmt_val.call(input["select_t_sec"]) %></td></tr>
              <tr><th scope="row">Input.Ball Model</th><td><%= fmt_val.call(input["ball_model"]) %></td></tr>
              <tr><th scope="row">Input.Pose Model</th><td><%= fmt_val.call(input["pose_model"]) %></td></tr>
              <tr><th scope="row">Input.Baseline</th><td><%= fmt_val.call(input["baseline"]) %></td></tr>

              <tr><th scope="row">ShotSummary.Total Frames</th><td><%= fmt_val.call(shot_summary["total_frames"]) %></td></tr>
              <tr><th scope="row">ShotSummary.FPS</th><td><%= fmt_num.call(shot_summary["fps"], 2) %></td></tr>
              <tr><th scope="row">ShotSummary.Duration (s)</th><td><%= fmt_num.call(shot_summary["duration_seconds"], 2) %></td></tr>
              <tr><th scope="row">ShotSummary.Resolution</th><td><%= fmt_val.call(shot_summary["resolution"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Net Y</th><td><%= fmt_val.call(shot_summary["net_y"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Total Hits</th><td><%= fmt_val.call(shot_summary["total_hits"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Court Player IDs</th><td><%= fmt_val.call(shot_summary["court_player_ids"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Focus Player ID</th><td><%= fmt_val.call(shot_summary["focus_player_id"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Focus Desc</th><td><%= fmt_val.call(shot_summary["focus_desc"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Baseline Used</th><td><%= fmt_val.call(shot_summary["baseline_used"]) %></td></tr>
              <tr><th scope="row">ShotSummary.Baseline N Hits</th><td><%= fmt_val.call(shot_summary["baseline_n_hits"]) %></td></tr>

              <tr><th scope="row">FormAnalysis.Per Shot Count</th><td><%= fmt_val.call(Array(form_analysis["per_shot_form"]).size) %></td></tr>
              <tr><th scope="row">Coaching.Mean Contact</th><td><%= fmt_num.call(overall["mean_contact"], 2) %></td></tr>
              <tr><th scope="row">Coaching.Mean Prep</th><td><%= fmt_num.call(overall["mean_prep"], 2) %></td></tr>
              <tr><th scope="row">Coaching.Mean Recovery</th><td><%= fmt_num.call(overall["mean_recovery"], 2) %></td></tr>
              <tr><th scope="row">Coaching.N Scored</th><td><%= fmt_val.call(overall["n_scored"]) %></td></tr>
              <tr><th scope="row">Recommendations Count</th><td><%= fmt_val.call(Array(coaching_summary["recommendations"]).compact.size) %></td></tr>
              <tr><th scope="row">Feedback Error</th><td><%= fmt_val.call(payload["feedback_error"]) %></td></tr>
            </tbody>
          </table>
        </div>

        <details class="mt-3">
          <summary><strong>Raw cv_results JSON</strong></summary>
          <pre class="mt-2 mb-0" style="max-height: 420px; overflow:auto;"><%= JSON.pretty_generate(payload) rescue payload.to_json %></pre>
        </details>

        <% if cv_meta.present? %>
          <details class="mt-3">
            <summary><strong>Raw runner metadata (top-level)</strong></summary>
            <pre class="mt-2 mb-0" style="max-height: 260px; overflow:auto;"><%= JSON.pretty_generate(cv_meta) rescue cv_meta.to_json %></pre>
          </details>
        <% end %>
      </div>
    <% end %>

    <% if @conversation&.messages&.any? %>
      <div class="page-card">
        <h5>Conversation</h5>
        <div class="themed-list mt-3">
          <% @conversation.messages.order(created_at: :asc).each do |message| %>
            <div class="list-group-item">
              <strong class="text-uppercase"><%= message.role %>:</strong>
              <div><%= simple_format(message.content) %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
